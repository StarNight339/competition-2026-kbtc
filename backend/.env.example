# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่อง (ห้าม commit .env)

PORT_SERVER=5000

# สร้าง key สุ่มด้วยคำสั่ง:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_KEY=change-me-to-a-long-random-string
JWT_EXPIRES=1h

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db-kbtcweb

# อนุญาตให้ frontend ที่ไหนเรียก API ได้ (คั่นด้วย , )
CORS_ORIGIN=http://localhost:3000

# รหัสผ่านเริ่มต้นตอนรัน npm run seed
SEED_PASSWORD=Kbtc@2026
